# Root .env (NEVER COMMIT; testnet-only keys). Used by contract deploy scripts and the relay.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Demo actors for Seed.s.sol: 1 relayer · 2 world attestor · 3 mock attestor · 4 kite attestor
# 5 broker X · 6 broker Y · 7 Alice · 8 Dev · 9 Bob · 10 Carol
DEMO_MNEMONIC=""
RELAYER_ADDRESS=
WORLD_ATTESTOR_ADDRESS=
MOCK_ATTESTOR_ADDRESS=
KITE_ATTESTOR_ADDRESS=
RELAYER_PRIVATE_KEY=
# Optional: real test USDT on Whitechain Sepolia (empty => deploy MockUSDT)
USDT_ADDRESS=

# app/.env.local (see app/.env.whitechain for the testnet variant)
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_DEMO_MODE=true
# RELAYER_PRIVATE_KEY= WORLD_ATTESTOR_PRIVATE_KEY= MOCK_ATTESTOR_PRIVATE_KEY= KITE_ATTESTOR_PRIVATE_KEY=
# NEXT_PUBLIC_WORLD_APP_ID= NEXT_PUBLIC_WORLD_RP_ID= NEXT_PUBLIC_WORLD_ENV=staging WORLD_RP_SIGNING_KEY=
# KITE_API_KEY= KITE_API_SECRET=
# RECLAIM_APP_ID= RECLAIM_APP_SECRET= RECLAIM_PROVIDER_ID=

# services/relay/.env
